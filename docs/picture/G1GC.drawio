                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-292" value="HeapRegion" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1930" y="210" width="110" height="50" as="geometry"/>
                </mxCell>
