                <mxCell id="x9Wx8xN-JiTPGkoRauTh-88" value="&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b&gt;Klass Space&lt;/b&gt;&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;shadow=1;" vertex="1" parent="1">
