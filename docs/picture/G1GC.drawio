                    <mxGeometry x="-460" y="1157.5" width="300" height="37.5" as="geometry"/>
                </mxCell>
                <mxCell id="UwDdM2gpIAp0ErtDOJtL-362" value="&lt;font face=&quot;Courier New&quot;&gt;1.作用：跟踪老年代对年轻代的引用&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Courier New&quot;&gt;2.这个是给card table使用的，负责管理卡表所需要的虚拟内存空间&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
