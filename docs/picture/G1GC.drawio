                <mxCell id="OSj8RTBEWgCXbP2xkJ4S-111" value="&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b&gt;Heap&lt;/b&gt;&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;shadow=1;" parent="1" vertex="1">
