                <mxCell id="IXn76zfCx8zDxPE3tXVj-243" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="840" y="550" width="70" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-244" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;0&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="380" y="600" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-245" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;2047&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="860" y="605" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-246" value="&lt;div&gt;&lt;span style=&quot;font-weight: 700; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;用于快速判断某个Region是否可以分配新对象&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="350" y="620" width="440" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-247" value="&lt;font&gt;6大映射器&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="80" y="440" width="210" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-248" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="IXn76zfCx8zDxPE3tXVj-249" target="IXn76zfCx8zDxPE3tXVj-260">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-249" value="&lt;font&gt;在这里单独再介绍一下这个_regions的作用：&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;font&gt;&#x9;1. _regions 是一个存储 HeapRegion指针的数组&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2. 核心问题：在GC过程中,&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; white-space: pre;&quot;&gt;&lt;font&gt;给定一个堆内存地址 0x600400000，它属于哪个 HeapRegion？&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; white-space: pre;&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;朴素解法：&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; white-space: pre;&quot;&gt;&lt;font&gt;遍历所有 Region，检查地址是否在范围内。但这是 O(n) 复杂度，太慢了&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;_regions 的解法：建立一个地址到 Region 的映射数组，实现 O(1) 查找 「通过addr_to_region(addr)来实现」&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=default;dashed=1;dashPattern=12 12;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="350" y="-100" width="700" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-250" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="IXn76zfCx8zDxPE3tXVj-251">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1425" y="-260" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-251" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1390" y="-150" width="70" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-252" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1460" y="-150" width="70" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-253" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1530" y="-150" width="70" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-254" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1600" y="-150" width="70" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-255" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1670" y="-150" width="70" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-256" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" source="IXn76zfCx8zDxPE3tXVj-257" target="IXn76zfCx8zDxPE3tXVj-264">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-257" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1740" y="-150" width="70" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-258" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1810" y="-150" width="70" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-259" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1880" y="-150" width="70" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-260" value="&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;HeapRegion* regions&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=default;dashed=1;dashPattern=12 12;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1240" y="-140" width="140" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-261" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;0&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1416" y="-90" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-262" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;2047&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1900" y="-90" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-263" value="&lt;font&gt;HeapRegion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1336" y="-360" width="190" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-264" value="&lt;font&gt;HeapRegion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1680" y="-360" width="190" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-265" value="&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;font&gt;假设使用这样的一个数组来存储所有的HeapRegion对象&lt;/font&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;font&gt;那么对于给定的一个堆地址：addr,如果知道它所属的region呢？&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;font&gt;只能通过下面的操作：减法 + 除法&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;font&gt; 1. size_t index = (addr - heap_start) / region_size&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;font&gt; 2. return  regions[index]&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;对于经常阅读源码的各位大佬们，应该会经常看到位运算,在这里也是一样的道理&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=default;dashed=1;dashPattern=12 12;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="2010" y="-200" width="440" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-266" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: pre; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;朴素实现方式&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1110" y="-80" width="80" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-267" value="0x600000000" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1310" y="-390" width="80" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-268" value="0x600400000" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1470" y="-390" width="80" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-269" value="" style="endArrow=classic;html=1;rounded=0;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" edge="1" parent="1" target="IXn76zfCx8zDxPE3tXVj-267">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="1350" y="-460" as="sourcePoint"/>
                        <mxPoint x="1380" y="-500" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-270" value="&lt;font&gt;heap_start&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1320" y="-500" width="60" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-271" value="&lt;font&gt;HeapRegion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1336" y="50" width="190" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-272" value="0x600000000" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1310" y="20" width="80" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-273" value="0x600400000" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1470" y="20" width="80" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-274" value="&lt;span style=&quot;white-space: pre;&quot;&gt;以其中一个HeapRegion为例：&lt;/span&gt;0x600000000 ～ 0x600400000，注意这里是坐左闭右开[ xxx,&amp;nbsp; xxx)&lt;div&gt;在这中间的任意一个地址，其实都是属于第一个HeapRegion的, 那么看：&lt;br&gt;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;0x600000000 ~ 0x&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;0x600400000(这个是开区间) / 4MB(region_size) = 0x1800&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;第二个region所对应的地址范围计算出来的是 ：0x&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;0x1801&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;而这个除法 则可以转换为 addr &amp;gt;&amp;gt; 22(region_size),注意哦,这里不需要减法，因为region都是4MB对齐的，属于同一个region的地址计算出来的都是相同的值&lt;/div&gt;&lt;div&gt;那么是否可以通过这个计算出来的值来O(1)查找呢？&lt;/div&gt;&lt;div&gt;-- 既然要时间，那么是否付出一点空间是值得的呢？&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;以8GB的堆空间为例:&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;0x600000000&lt;/b&gt; ~&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;0x7FC00000&lt;/b&gt;&lt;font color=&quot;rgba(0, 0, 0, 0)&quot;&gt;&lt;b&gt;&amp;nbsp;--&amp;gt;&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(0x1800 ~ 0x1FFF) = [6144,8191]&lt;/b&gt;&lt;/div&gt;&lt;div&gt;那么在初始化的时候就创建一个长度为8191长度的数组&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=default;dashed=1;dashPattern=12 12;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1600" y="30" width="860" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-275" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1600" y="310" width="70" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-276" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1670" y="310" width="70" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-277" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1740" y="310" width="70" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-278" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1810" y="310" width="70" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-279" value="" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1880" y="310" width="70" height="50" as="geometry"/>
                </mxCell>
