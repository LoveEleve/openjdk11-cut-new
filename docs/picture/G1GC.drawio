                <mxCell id="IXn76zfCx8zDxPE3tXVj-231" value="&lt;div style=&quot;text-align: start;&quot;&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 13px; white-space: pre;&quot;&gt;_length = &lt;/span&gt;&lt;span class=&quot;hljs-number&quot; style=&quot;box-sizing: border-box; font-size: 13px; white-space: pre;&quot;&gt;2048&lt;/span&gt;&lt;span style=&quot;font-size: 13px; white-space: pre;&quot;&gt;;&lt;/span&gt;&lt;span class=&quot;hljs-comment&quot; style=&quot;box-sizing: border-box; font-style: italic; font-size: 13px; white-space: pre;&quot;&gt; &lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;hljs-comment&quot; style=&quot;box-sizing: border-box; font-style: italic; font-size: 13px; white-space: pre;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt; - 数组实际长度&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;hljs-comment&quot; style=&quot;box-sizing: border-box; font-style: italic; font-size: 13px; white-space: pre;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-style: normal;&quot;&gt;_shift_by = &lt;/span&gt;&lt;span class=&quot;hljs-number&quot; style=&quot;box-sizing: border-box; font-style: normal;&quot;&gt;22&lt;/span&gt;&lt;span style=&quot;font-style: normal;&quot;&gt;;&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;hljs-comment&quot; style=&quot;box-sizing: border-box; font-size: 13px; white-space: pre;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span class=&quot;hljs-comment&quot; style=&quot;box-sizing: border-box;&quot;&gt; - &lt;/span&gt;&lt;span class=&quot;hljs-comment&quot; style=&quot;font-style: italic; box-sizing: border-box;&quot;&gt;log2(4MB) = 22&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span class=&quot;hljs-comment&quot; style=&quot;box-sizing: border-box; font-size: 13px; white-space: pre;&quot;&gt;&lt;span class=&quot;hljs-comment&quot; style=&quot;font-style: italic; box-sizing: border-box;&quot;&gt; - &lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;将堆地址转换为区域索引&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;hljs-comment&quot; style=&quot;box-sizing: border-box; font-style: italic; font-size: 13px; white-space: pre;&quot;&gt;&lt;span class=&quot;hljs-comment&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-style: normal;&quot;&gt;_bias = &lt;/span&gt;&lt;span class=&quot;hljs-number&quot; style=&quot;box-sizing: border-box; font-style: normal;&quot;&gt;0x1800&lt;/span&gt;&lt;span style=&quot;font-style: normal;&quot;&gt;;  &lt;/span&gt;&lt;span class=&quot;hljs-comment&quot; style=&quot;box-sizing: border-box;&quot;&gt;// 堆起始地址对应的索引偏移&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 13px; white-space: pre;&quot;&gt;&lt;i&gt;&amp;nbsp;- &lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;用于将biased_index转换为真实数组索引&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;h3 style=&quot;box-sizing: border-box; font-size: 13px; margin-block: 0px;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;code class=&quot;&quot; style=&quot;box-sizing: border-box; padding: 1px 3px; border-radius: 3px; padding-inline: 4px; pointer-events: none;&quot;&gt;_biased_base&lt;/code&gt;&amp;nbsp;- 偏移后的基地址&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp;-&amp;nbsp;&lt;span style=&quot;font-size: 13px;&quot;&gt;实现直接用biased_index访问数组&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;labelBackgroundColor=none;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="700" y="355" width="380" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-232" value="&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;font-size: 13px; white-space: pre;&quot;&gt;&lt;font&gt;其他属性&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;labelBackgroundColor=none;fontColor=default;fontFamily=Comic Sans MS;" vertex="1" parent="1">
