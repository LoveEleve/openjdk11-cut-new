                    <mxGeometry x="2140" y="210" width="110" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-294" value="HeapRegion" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="2280" y="210" width="110" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-295" value="HeapRegion* base[]" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1470" y="320" width="120" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-296" value="&lt;span style=&quot;white-space: pre;&quot;&gt;此时对于一个给定的addr，如果找到其所对应的region呢？&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;1. size_t index = addr &amp;gt;&amp;gt; 22&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;2. return base[index]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;只需要一次位运算 + 数组O(1)，相比于减法 + 除法 那可是快了&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;==&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;理论上到这里其实也就可以了，但是有个问题就是虽然是空间换时间，但是空间也不能太浪费上，比如上面的内存使用率就很低，那么怎么办呢？&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;我只用了2048个位置,那么就只分配2048个呗，这还不简单？&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=default;dashed=1;dashPattern=12 12;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1600" y="425" width="860" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-297" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=default;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=default;fillColor=#1ba1e2;rotation=-90;" vertex="1" parent="1">
                    <mxGeometry x="1771.25" y="203.75" width="20" height="342.5" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-298" value="空间浪费了(6144*8B,大约48KB的内存)" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1687.5" y="385" width="220" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="IXn76zfCx8zDxPE3tXVj-299" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="IXn76zfCx8zDxPE3tXVj-300" target="IXn76zfCx8zDxPE3tXVj-310">
