                <mxCell id="TPs2xcH5xDideXQqY0BG-666" value="&lt;font&gt;&lt;b&gt;4MB / (4KB * 64) = 16&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Comic Sans MS;" vertex="1" parent="1">
