                    <mxGeometry x="1682.5" y="1560" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-751" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: pre; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;G1MappingChangedListener&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1722.5" y="1545" width="220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-752" value="&lt;span style=&quot;font-size: 13px; text-align: start; white-space: pre;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;on_commit()&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1757.5" y="1580" width="120" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-753" value="&lt;font&gt;&lt;span style=&quot;font-size: 13px; white-space: pre;&quot;&gt;默认为都0&lt;/span&gt;&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="2010" y="1360" width="100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-754" value="&lt;font&gt;&lt;span style=&quot;font-size: 13px; white-space: pre;&quot;&gt;默认为都0&lt;/span&gt;&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="2470" y="1075" width="100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-755" value="&lt;font&gt;&lt;b&gt;每个区域对应16个页面&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1470" y="1411.25" width="126" height="22.5" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-756" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Comic Sans MS;" edge="1" parent="1" source="TPs2xcH5xDideXQqY0BG-757" target="TPs2xcH5xDideXQqY0BG-758">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-757" value="&lt;font&gt;&lt;b&gt;4MB / (4KB * 64) = 16&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1190" y="1437.5" width="178" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-758" value="&lt;font&gt;&lt;b&gt;在这里代表的是：在Region中,每64B对应一个标记位，那么存储一个Region的标记位则需要4MB / 64B = 64KB(也即16个4KB大小的page)&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1019" y="1515" width="521" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-759" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;&lt;b&gt;G1RegionToSpaceMapper*&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font&gt;&lt;b&gt;next_bitmap_storage&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=12 12;strokeColor=#FF3333;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="700" y="1282.5" width="250" height="87.5" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-760" value="&lt;font&gt;&lt;span style=&quot;font-size: 13px; white-space: pre;&quot;&gt;OS自己选择的地址(&lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 13px; white-space: pre;&quot;&gt;128MB&lt;/span&gt;&lt;font&gt;&lt;span style=&quot;font-size: 13px; white-space: pre;&quot;&gt;)&lt;/span&gt;&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="2030" y="1010" width="160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-761" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 13px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: pre; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;32768&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="3280" y="1160" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-762" value="- 存储上一轮并发标记的结果：保存已完成的标记周期中所有存活对象的标记信息&#xa;- 增量收集的基础：在Mixed GC中，作为判断老年代对象存活性的依据&#xa;- 稳定的引用基准：提供一个&quot;快照&quot;，避免并发标记过程中的不一致性" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;align=left;" vertex="1" parent="1">
                    <mxGeometry x="210" y="570" width="470" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-763" value="- 存储当前并发标记的结果：正在进行的标记周期中新发现的存活对象&#xa;- 并发标记的工作区：标记线程在此位图上设置新的标记位&#xa;- 双缓冲机制：完成后与prev_bitmap交换，实现无锁切换" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="228" y="1285" width="410" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-764" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1.&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;：&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;G1CMBitMap类型的&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;2.&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;_mark_bitmap_2：&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;G1CMBitMap类型的&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font&gt;3.&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;_prev_mark_bitmap(&amp;amp;_mark_bitmap_1)：&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;G1CMBitMap指针类型的&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;4.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;_next_mark_bitmap(&amp;amp;_mark_bitmap_2)：&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;G1CMBitMap指针类型的&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=12 12;strokeColor=#FF3333;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="240" y="2000" width="500" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-765" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font&gt;双位图初始化&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=12 12;strokeColor=#b85450;fillColor=#f8cecc;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="240" y="1970" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-766" value="&lt;font&gt;这两个属性的作用是什么呢？&lt;/font&gt;&lt;div&gt;&lt;font&gt;看下这个属性对应的类型的内存布局&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;div&gt;class G1CMBitMap {&lt;/div&gt;&lt;div&gt;&amp;nbsp; MemRegion _covered;&amp;nbsp; &amp;nbsp; // 覆盖的堆区域 (起始地址 + 大小)&lt;/div&gt;&lt;div&gt;&amp;nbsp; const int _shifter;&amp;nbsp; &amp;nbsp; // 移位量 = LogMinObjAlignment = 3&lt;/div&gt;&lt;div&gt;&amp;nbsp; BitMapView _bm;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // 实际位图视图 (指针 + 大小)&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div&gt;&lt;font&gt;&lt;div&gt;class BitMap {&amp;nbsp;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;div&gt;&amp;nbsp;bm_word_t* _map;   // 位图数组的指针 (实际存储)&amp;nbsp;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;div&gt;&amp;nbsp;idx_t _size;       // 位图大小（位数）&amp;nbsp;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;div&gt;};&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;&lt;font&gt;&lt;div&gt;&amp;nbsp; G1CMBitMapMappingChangedListener _listener;&amp;nbsp; // 内存映射监听器&lt;/div&gt;&lt;div&gt;};&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="820" y="1774" width="400" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-767" value="" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=hachure;curveFitting=1;opacity=70;strokeColor=default;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="230" y="2210" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-768" value="&lt;span style=&quot;text-align: left;&quot;&gt;_mark_bitmap_1&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;" vertex="1" parent="1">
                    <mxGeometry x="230" y="2180" width="100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-769" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="TPs2xcH5xDideXQqY0BG-770" target="TPs2xcH5xDideXQqY0BG-771">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-770" value="&lt;span style=&quot;text-align: left;&quot;&gt;MemRegion _covered&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=solid;curveFitting=1;opacity=70;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=#dae8fc;" vertex="1" parent="1">
                    <mxGeometry x="230" y="2210" width="220" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-771" value="&lt;font style=&quot;forced-color-adjust: none; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;指向&lt;/font&gt;&lt;span style=&quot;font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;G1CollectedHeap-&amp;gt;reserved_region()所对应的MemRegion&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;labelBackgroundColor=default;" vertex="1" parent="1">
                    <mxGeometry x="490" y="2212.5" width="350" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-772" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;" edge="1" parent="1" source="TPs2xcH5xDideXQqY0BG-773" target="TPs2xcH5xDideXQqY0BG-842">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-773" value="&lt;span style=&quot;text-align: left;&quot;&gt;const int _shifter&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillWeight=4;hachureGap=8;hachureAngle=45;jiggle=2;fillStyle=solid;curveFitting=1;opacity=70;strokeColor=#6c8ebf;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontSize=12;fillColor=#dae8fc;" vertex="1" parent="1">
                    <mxGeometry x="230" y="2240" width="220" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-774" value="&lt;div&gt;这里还有一个问题，那就是为什么要弄出：&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;prev_bitmap_storage + mark_bitmap呢？&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;两者的职责不同：&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1. prev_bitmap_storage：物理内存管理,负责虚拟内存的预留，按需提交，释放，与Region的映射关系&lt;/span&gt;&lt;b&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2. mark_bitmap：逻辑位图操作，负责标记/清楚/查询对象，地址到bit的转换，遍历标记对象&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Comic Sans MS;fontSize=12;fontColor=default;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="820" y="2020" width="600" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-775" value="&lt;font&gt;&lt;span style=&quot;font-size: 13px; white-space: pre;&quot;&gt;堆内存的每64个字节对应位图中的1个字节&lt;/span&gt;&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="1995" y="210" width="240" height="30" as="geometry"/>
