                <mxCell id="e7IyhpmQDptYtsb1s5FK-3" value="&lt;font face=&quot;Comic Sans MS&quot;&gt;StringTable的作用：&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Java 字符串常量池的底层实现，负责存储和管理所有intern()过的字符串&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;通过哈希表去重，确保相同内容的字符串在jvm中只存在一份&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=default;dashed=1;dashPattern=12 12;" vertex="1" parent="1">
                    <mxGeometry x="550" y="100" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e7IyhpmQDptYtsb1s5FK-4" value="StringTable 实例内存布局 (64位系统, cache line = 64字节)&#xa;┌────────────────────────────────────────────────────────────────┐&#xa;│ offset │ size │ field            │ 说明                        │&#xa;├────────┼──────┼──────────────────┼────────────────────────────┤&#xa;│ 0x00   │ 8B   │ _local_table     │ → ConcurrentHashTable       │&#xa;├────────┼──────┼──────────────────┼────────────────────────────┤&#xa;│ 0x08   │ 8B   │ _current_size    │ = 65536 (初始)              │&#xa;├────────┼──────┼──────────────────┼────────────────────────────┤&#xa;│ 0x10   │ 1B   │ _has_work        │ = false                     │&#xa;├────────┼──────┼──────────────────┼────────────────────────────┤&#xa;│ 0x11   │ 1B   │ _needs_rehashing │ = false                     │&#xa;├────────┼──────┼──────────────────┼────────────────────────────┤&#xa;│ 0x12   │ 6B   │ (padding)        │ 对齐到 8 字节               │&#xa;├────────┼──────┼──────────────────┼────────────────────────────┤&#xa;│ 0x18   │ 8B   │ _weak_handles    │ → OopStorage                │&#xa;├────────┼──────┼──────────────────┼────────────────────────────┤&#xa;│ 0x20   │ 8B   │ _items           │ = 0 (初始)                  │&#xa;├────────┼──────┼──────────────────┼────────────────────────────┤&#xa;│ 0x28   │ 56B  │ (cache line pad) │ 避免 false sharing          │&#xa;├────────┼──────┼──────────────────┼────────────────────────────┤&#xa;│ 0x60   │ 8B   │ _uncleaned_items │ = 0 (初始)                  │&#xa;├────────┼──────┼──────────────────┼────────────────────────────┤&#xa;│ 0x68   │ 56B  │ (cache line pad) │ 避免 false sharing          │&#xa;└────────┴──────┴──────────────────┴────────────────────────────┘&#xa;总大小: 0xA0 = 160 字节" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;strokeColor=default;" vertex="1" parent="1">
                    <mxGeometry x="290" y="320" width="580" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="e7IyhpmQDptYtsb1s5FK-5" value="&lt;font face=&quot;Comic Sans MS&quot;&gt;StringTable实例内存布局&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
                    <mxGeometry x="413" y="270" width="186" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="e7IyhpmQDptYtsb1s5FK-6" value="&lt;span style=&quot;font-family: &amp;quot;Comic Sans MS&amp;quot;; text-align: left;&quot;&gt;ConcurrentHashTable&amp;nbsp;&lt;/span&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;实例内存布局&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
                    <mxGeometry x="1148" y="250" width="212" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="e7IyhpmQDptYtsb1s5FK-7" value="ConcurrentHashTable 内存布局&#xa;┌────────────────────────────────────────────────────────────────┐&#xa;│ offset │ size │ field              │ 说明                      │&#xa;├────────┼──────┼────────────────────┼──────────────────────────┤&#xa;│ 0x00   │ 8B   │ _table             │ → InternalTable (当前表)  │&#xa;├────────┼──────┼────────────────────┼──────────────────────────┤&#xa;│ 0x08   │ 8B   │ _new_table         │ = NULL (扩容时非空)       │&#xa;├────────┼──────┼────────────────────┼──────────────────────────┤&#xa;│ 0x10   │ 8B   │ _log2_size_limit   │ = 24                      │&#xa;├────────┼──────┼────────────────────┼──────────────────────────┤&#xa;│ 0x18   │ 8B   │ _log2_start_size   │ = 16                      │&#xa;├────────┼──────┼────────────────────┼──────────────────────────┤&#xa;│ 0x20   │ 8B   │ _grow_hint         │ = 4                       │&#xa;├────────┼──────┼────────────────────┼──────────────────────────┤&#xa;│ 0x28   │ 1B   │ _size_limit_reached│ = false                   │&#xa;├────────┼──────┼────────────────────┼──────────────────────────┤&#xa;│ 0x29   │ 7B   │ (padding)          │                           │&#xa;├────────┼──────┼────────────────────┼──────────────────────────┤&#xa;│ 0x30   │ 8B   │ _resize_lock       │ → Mutex                   │&#xa;├────────┼──────┼────────────────────┼──────────────────────────┤&#xa;│ 0x38   │ 8B   │ _resize_lock_owner │ = NULL                    │&#xa;├────────┼──────┼────────────────────┼──────────────────────────┤&#xa;│ 0x40   │ 8B   │ _invisible_epoch   │ = NULL                    │&#xa;└────────┴──────┴────────────────────┴──────────────────────────┘&#xa;总大小: 0x48 = 72 字节" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;strokeColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="320" width="560" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="e7IyhpmQDptYtsb1s5FK-8" value="InternalTable 内存布局&#xa;┌────────────────────────────────────────────────────────────────┐&#xa;│ offset │ size │ field      │ 说明                              │&#xa;├────────┼──────┼────────────┼──────────────────────────────────┤&#xa;│ 0x00   │ 8B   │ _buckets   │ → Bucket[65536]                   │&#xa;├────────┼──────┼────────────┼──────────────────────────────────┤&#xa;│ 0x08   │ 8B   │ _log2_size │ = 16                              │&#xa;├────────┼──────┼────────────┼──────────────────────────────────┤&#xa;│ 0x10   │ 8B   │ _size      │ = 65536                           │&#xa;├────────┼──────┼────────────┼──────────────────────────────────┤&#xa;│ 0x18   │ 8B   │ _hash_mask │ = 0xFFFF                          │&#xa;└────────┴──────┴────────────┴──────────────────────────────────┘&#xa;总大小: 0x20 = 32 字节&#xa;&#xa;&#xa;Bucket 数组: 65536 × 8B = 512 KB（独立分配）" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;strokeColor=default;" vertex="1" parent="1">
                    <mxGeometry x="290" y="810" width="560" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="e7IyhpmQDptYtsb1s5FK-9" value="&lt;span style=&quot;font-family: &amp;quot;Comic Sans MS&amp;quot;; text-align: left;&quot;&gt;InternalTable&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Comic Sans MS&amp;quot;; text-align: left;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;实例内存布局&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
                    <mxGeometry x="450" y="760" width="212" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="e7IyhpmQDptYtsb1s5FK-10" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;Bucket&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;" vertex="1" parent="1">
                    <mxGeometry x="1170" y="760" width="212" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="e7IyhpmQDptYtsb1s5FK-11" value="Bucket 内存布局&#xa;┌────────────────────────────────────────────────────────────────┐&#xa;│ offset │ size │ field  │ 说明                                  │&#xa;├────────┼──────┼────────┼──────────────────────────────────────┤&#xa;│ 0x00   │ 8B   │ _first │ Node* + 状态位                        │&#xa;│        │      │        │   bit 0: LOCK                         │&#xa;│        │      │        │   bit 1: REDIRECT                     │&#xa;│        │      │        │   bit 2-63: Node 地址                 │&#xa;└────────┴──────┴────────┴──────────────────────────────────────┘&#xa;总大小: 8 字节&#xa;&#xa;&#xa;Bucket[65536] 数组总大小: 512 KB&#xa;初始状态：所有 _first = NULL (0x0)" style="text;whiteSpace=wrap;fontFamily=Comic Sans MS;strokeColor=default;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="820" width="560" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="e7IyhpmQDptYtsb1s5FK-12" value="Node 内存布局&#xa;┌────────────────────────────────────────────────────────────────┐&#xa;│ offset │ size │ field  │ 说明                                  │&#xa;├────────┼──────┼────────┼──────────────────────────────────────┤&#xa;│ 0x00   │ 8B   │ _next  │ → 下一个 Node / NULL                  │&#xa;├────────┼──────┼────────┼──────────────────────────────────────┤&#xa;│ 0x08   │ 8B   │ _value │ WeakHandle，内含 _obj 指针            │&#xa;│        │      │        │   _obj → OopStorage::Block::_data[i]  │&#xa;└────────┴──────┴────────┴──────────────────────────────────────┘&#xa;总大小: 0x10 = 16 字节" style="text;whiteSpace=wrap;strokeColor=default;fontFamily=Comic Sans MS;" vertex="1" parent="1">
                    <mxGeometry x="290" y="1200" width="560" height="170" as="geometry"/>
