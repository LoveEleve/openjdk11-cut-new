                <mxCell id="QI2BOtYcePDBQrvWRp4a-27" value="" style="rounded=1;whiteSpace=wrap;html=1;fillWeight=4;hachureGap=8;hachureAngle=45;fillStyle=hachure;opacity=70;strokeColor=#ae4132;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=#fad9d5;" vertex="1" parent="1">
                    <mxGeometry x="385" y="610" width="35" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="QI2BOtYcePDBQrvWRp4a-28" value="" style="rounded=1;whiteSpace=wrap;html=1;fillWeight=4;hachureGap=8;hachureAngle=45;fillStyle=hachure;opacity=70;strokeColor=#23445d;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="500" y="610" width="90" height="50" as="geometry"/>
