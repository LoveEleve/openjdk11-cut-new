                    <mxGeometry x="2820" y="1445" width="30" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="TPs2xcH5xDideXQqY0BG-747" value="&lt;font&gt;&lt;span style=&quot;font-size: 13px; white-space: pre;&quot;&gt;...&lt;/span&gt;&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;" vertex="1" parent="1">
