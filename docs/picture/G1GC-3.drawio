                <mxCell id="242" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-family: Consolas, Monaco, monospace; font-weight: 400;&quot;&gt;&lt;font&gt;DirtyCardQueueSet&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
