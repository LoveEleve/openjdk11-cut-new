                <mxCell id="241" value="&lt;span style=&quot;color: rgb(51, 51, 51); font-family: Consolas, Monaco, monospace; text-align: center; white-space: pre;&quot;&gt;处理完毕放入到空间链表(缓存起来)&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
