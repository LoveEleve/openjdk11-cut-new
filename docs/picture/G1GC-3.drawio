                <mxCell id="179" value="&lt;font face=&quot;Consolas, Monaco, monospace&quot;&gt;size_t _index&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;" vertex="1" parent="1">
