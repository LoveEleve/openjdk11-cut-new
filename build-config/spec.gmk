BUILDJDK_OUTPUTDIR=$(OUTPUTDIR)/buildjdk

BUILD_FAILURE_HANDLER := false

ENABLE_GENERATE_CLASSLIST := true

EXCLUDE_TRANSLATIONS := 

BUILD_MANPAGES := true

ALLOW_ABSOLUTE_PATHS_IN_OUTPUT := true

# The boot jdk to use. This is overridden in bootcycle-spec.gmk. Make sure to keep
# it in sync.
BOOT_JDK:=/usr/local/share/javaEnv/jdk-10

BUILD_JDK:=$(JDK_OUTPUTDIR)
CREATE_BUILDJDK:=false
EXTERNAL_BUILDJDK:=false

# When compiling Java source to be run by the boot jdk
# use these extra flags, eg -source 6 -target 6
BOOT_JDK_SOURCETARGET:=-source 9 -target 9

# Information about the build system
NUM_CORES:=8
MEMORY_SIZE:=15733
# Enable sjavac support = use a javac server,
# multi core javac compilation and dependency tracking.
ENABLE_SJAVAC:=no
ENABLE_JAVAC_SERVER:=yes
# Store sjavac server synchronization files here, and
# the sjavac server log files.
