# ============================================================
# .codebuddyignore — CodeBuddy 索引排除规则
# 目标：只索引核心源码 + 分析文档，跳过构建产物和二进制文件
# ============================================================

# ── 构建产物（体积最大，完全不需要索引）──────────────────────
build/
cmake-build-debug/
build-config/

# ── IDE / 工具配置 ────────────────────────────────────────────
.git/
.idea/
.clion.source.upload.marker

# ── 日志 / 临时文件 ───────────────────────────────────────────
*.log
gdb.txt
hs_err_pid*.log
config.log
configure.log

# ── 二进制 / 归档文件 ─────────────────────────────────────────
*.class
*.jar
*.jmod
*.so
*.o
*.a
*.dylib
*.dll
*.exe
*.zip
*.tar
*.gz

